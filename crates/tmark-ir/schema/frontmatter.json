{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Keys",
  "description": "Generated by `cargo run -p tmark-ir --example schema` from the Rust types of tmark-ir; do not edit. The typed subset of the front matter (spec §Front matter). Serialises to the canonical layout: metadata at the root, the rest under `press`.",
  "type": "object",
  "properties": {
    "authors": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Author"
      }
    },
    "date": {
      "description": "ISO date, free text, or `commit`; kept as written.",
      "type": [
        "string",
        "null"
      ]
    },
    "epigraph": {
      "anyOf": [
        {
          "$ref": "#/definitions/Epigraph"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "description": "Document identifier for cross-document references.",
      "type": [
        "string",
        "null"
      ]
    },
    "lang": {
      "description": "Document language (`fr`, `en-GB`).",
      "type": [
        "string",
        "null"
      ]
    },
    "press": {
      "$ref": "#/definitions/Press"
    },
    "subtitle": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "description": "`None` when absent (the first heading is promoted), `Some(None)` for `title: null` (spec §Header: opt out of promotion).",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "definitions": {
    "AdmonitionDecl": {
      "description": "A declared admonition type. Spec §Admonition.",
      "type": "object",
      "properties": {
        "counter": {
          "description": "Counter prefix of a theorem-type admonition.",
          "type": [
            "string",
            "null"
          ]
        },
        "group": {
          "description": "Section title under the `reference` strategy.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "reference": {
          "description": "Text of the \"See page N\" link, with a `{page}` field.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Author": {
      "description": "Spec §Front matter: `authors: [{name, affiliation}]`.",
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "affiliation": {
          "type": [
            "string",
            "null"
          ]
        },
        "email": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        }
      }
    },
    "CounterDecl": {
      "description": "A user-declared (or overridden) counter. Spec §Counters.",
      "type": "object",
      "properties": {
        "format": {
          "description": "Python format string over `n`, `prefix`, `key`; default `\"{n}\"`.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Label word, used in references and diagnostics.",
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "description": "Template a reference renders, with `{name}` and `{number}` fields.",
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/definitions/Scope"
            },
            {
              "type": "null"
            }
          ]
        },
        "start": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "Declare": {
      "description": "`declare`: what things *are*. Spec §Front matter, §Counters, §Admonition, §Glossary and acronyms.",
      "type": "object",
      "properties": {
        "acronyms": {
          "description": "Structure owned by TeXSmith for now; kept as JSON."
        },
        "admonitions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/AdmonitionDecl"
          }
        },
        "counters": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/CounterDecl"
          }
        },
        "glossary": {
          "description": "Structure owned by TeXSmith for now; kept as JSON."
        }
      }
    },
    "Epigraph": {
      "description": "Spec §BlockQuote: `epigraph: {quote, source}` placed before the first heading.",
      "type": "object",
      "required": [
        "quote"
      ],
      "properties": {
        "quote": {
          "type": "string"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Press": {
      "description": "The `press` namespace, restricted to the keys TMark reads.",
      "type": "object",
      "properties": {
        "base_level": {
          "description": "What a top-level `#` maps to (`chapter`, `section`, …). Spec §Header.",
          "type": [
            "string",
            "null"
          ]
        },
        "declare": {
          "$ref": "#/definitions/Declare"
        },
        "features": {
          "description": "Spec §Feature registry: dotted name to switch.",
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "sources": {
          "$ref": "#/definitions/Sources"
        }
      }
    },
    "Scope": {
      "description": "Numbering scope of a counter. Spec §Counters (`scope`).",
      "type": "string",
      "enum": [
        "document",
        "chapter",
        "section"
      ]
    },
    "Sources": {
      "description": "`sources`: where references resolve. Spec §Bibliography, §Cross-document references.",
      "type": "object",
      "properties": {
        "bibliography": {
          "description": "A map of key to DOI URL or pybtex-shaped entry, or a list of `.bib` paths; kept as JSON, `tmark-registry` interprets it."
        },
        "crossrefs": {
          "description": "Alias to inventory path.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
