{
  "name": "vscode-tmark",
  "displayName": "TMark (TeXSmith Markdown)",
  "description": "TMark, the Markdown dialect of TeXSmith: syntax highlighting and a language server (diagnostics, outline, folding, formatting) for roles, attributes, references, citations, index entries, counters, containers, data directives and captions.",
  "version": "0.1.0",
  "publisher": "texsmith",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/yves-chevallier/tmark",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "markdown",
    "tmark",
    "texsmith",
    "latex",
    "typst"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:tmark",
    "onLanguage:markdown"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tmark",
        "aliases": [
          "TMark",
          "TeXSmith Markdown"
        ],
        "extensions": [
          ".tm",
          ".tmd",
          ".tmark"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tmark",
        "scopeName": "text.html.markdown.tmark",
        "path": "./syntaxes/tmark.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.frontmatter": "yaml",
          "meta.embedded.block.yaml": "yaml",
          "meta.embedded.block.python": "python",
          "meta.embedded.block.latex": "latex",
          "meta.embedded.block.html": "html",
          "meta.embedded.block.typst": "typst",
          "meta.embedded.block.javascript": "javascript",
          "meta.embedded.block.json": "json",
          "meta.embedded.block.shellscript": "shellscript",
          "meta.embedded.block.css": "css",
          "meta.embedded.block.markdown": "markdown",
          "meta.embedded.math.markdown": "latex"
        }
      },
      {
        "scopeName": "text.html.markdown.tmark.injection",
        "path": "./syntaxes/tmark.injection.tmLanguage.json",
        "injectTo": [
          "text.html.markdown",
          "text.html.markdown.tmark"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.yaml": "yaml",
          "meta.embedded.block.python": "python",
          "meta.embedded.block.latex": "latex",
          "meta.embedded.block.html": "html",
          "meta.embedded.block.typst": "typst",
          "meta.embedded.math.markdown": "latex"
        }
      }
    ],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "markup.highlight.tmark",
            "settings": {
              "foreground": "#D4A72C"
            }
          },
          {
            "scope": "markup.smallcaps.tmark",
            "settings": {
              "foreground": "#8A7CC7"
            }
          },
          {
            "scope": [
              "markup.superscript.tmark",
              "markup.subscript.tmark"
            ],
            "settings": {
              "foreground": "#5FA8A8"
            }
          },
          {
            "scope": "markup.underline.insert.tmark",
            "settings": {
              "fontStyle": "underline"
            }
          },
          {
            "scope": "invalid.deprecated.tmark, invalid.deprecated.role.tmark",
            "settings": {
              "fontStyle": "strikethrough"
            }
          },
          {
            "scope": "invalid.unresolved.reference.tmark, invalid.unknown.role.tmark",
            "settings": {
              "foreground": "#E5534B",
              "fontStyle": "underline"
            }
          }
        ]
      }
    },
    "commands": [
      {
        "command": "tmark.restartServer",
        "title": "TMark: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "TMark",
      "properties": {
        "tmark.serverPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `tmark-lsp` binary. Empty: the binary bundled with the extension, else `tmark-lsp` on the PATH.",
          "scope": "machine-overridable"
        },
        "tmark.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication with the language server."
        }
      }
    },
    "semanticTokenTypes": [
      {
        "id": "reference",
        "superType": "variable",
        "description": "A TMark reference that resolves"
      },
      {
        "id": "unresolvedReference",
        "superType": "variable",
        "description": "A TMark reference found in no registry"
      },
      {
        "id": "citation",
        "superType": "variable",
        "description": "A TMark citation of a bibliography entry"
      },
      {
        "id": "label",
        "superType": "property",
        "description": "A TMark definition: counter item, index entry"
      },
      {
        "id": "unknownRole",
        "superType": "function",
        "description": "A brace group that names no role"
      },
      {
        "id": "deprecated",
        "superType": "variable",
        "description": "A deprecated TMark spelling"
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "reference": [
            "support.type.reference.tmark"
          ],
          "unresolvedReference": [
            "invalid.unresolved.reference.tmark"
          ],
          "citation": [
            "support.type.reference.citation.tmark"
          ],
          "label": [
            "entity.other.attribute-name.counter.tmark"
          ],
          "unknownRole": [
            "invalid.unknown.role.tmark"
          ],
          "deprecated": [
            "invalid.deprecated.tmark"
          ]
        }
      }
    ]
  },
  "scripts": {
    "build:grammar": "cargo run -q --manifest-path ../../Cargo.toml -p tmark-ir --example registries && python3 scripts/build_grammar.py",
    "build": "esbuild src/extension.js --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --minify",
    "bundle:server": "sh scripts/bundle-server.sh",
    "test": "node --test test/grammar.test.mjs",
    "tokens": "node test/tokens.mjs",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.0.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
